<?php
// Enable error logging
ini_set('display_errors', 1);
ini_set('log_errors', 1);
error_reporting(E_ALL);

// Function to log errors to this file
function rbf_log_error($message, $type = 'ERROR') {
    $log_file = __DIR__ . '/debug-errors.log';
    $timestamp = date('Y-m-d H:i:s');
    $log_entry = "[$timestamp] [$type] $message" . PHP_EOL;
    
    // Append to log file
    file_put_contents($log_file, $log_entry, FILE_APPEND | LOCK_EX);
    
    // Also log to WordPress error log if available
    if (function_exists('error_log')) {
        error_log("RBF: $message");
    }
}

// Function to check PHP syntax
function rbf_check_php_syntax($file_path) {
    $output = shell_exec("php -l $file_path 2>&1");
    rbf_log_error("PHP Syntax Check for $file_path: $output", 'SYNTAX_CHECK');
    return $output;
}

// Function to get file info
function rbf_get_file_info($file_path) {
    if (file_exists($file_path)) {
        $content = file_get_contents($file_path);
        $lines = explode("\n", $content);
        $total_lines = count($lines);
        
        rbf_log_error("File: $file_path", 'FILE_INFO');
        rbf_log_error("Total Lines: $total_lines", 'FILE_INFO');
        rbf_log_error("File Size: " . filesize($file_path) . " bytes", 'FILE_INFO');
        
        return $total_lines;
    } else {
        rbf_log_error("File not found: $file_path", 'ERROR');
        return 0;
    }
}

// Check main plugin file
rbf_log_error("=== STARTING DEBUG SESSION ===", 'INFO');
rbf_get_file_info(__DIR__ . '/repair-booking-form.php');
rbf_check_php_syntax(__DIR__ . '/repair-booking-form.php');

// Check for common syntax issues
$content = file_get_contents(__DIR__ . '/repair-booking-form.php');
$lines = explode("\n", $content);

// Check for missing braces, semicolons, etc.
$brace_count = 0;
$parenthesis_count = 0;
$bracket_count = 0;

foreach ($lines as $line_num => $line) {
    $line_num++; // Convert to 1-based line numbers
    
    // Count brackets
    $brace_count += substr_count($line, '{') - substr_count($line, '}');
    $parenthesis_count += substr_count($line, '(') - substr_count($line, ')');
    $bracket_count += substr_count($line, '[') - substr_count($line, ']');
    
    // Check for common syntax issues
    if (preg_match('/^\s*public\s+function\s+(\w+)\s*\(/', $line, $matches)) {
        rbf_log_error("Line $line_num: Found public function: " . $matches[1], 'FUNCTION_DETECTED');
    }
    
    if (preg_match('/^\s*class\s+(\w+)/', $line, $matches)) {
        rbf_log_error("Line $line_num: Found class: " . $matches[1], 'CLASS_DETECTED');
    }
    
    // Check for missing semicolons
    if (preg_match('/^\s*[^\/\/]*[^;{}]\s*$/', $line) && 
        !preg_match('/^\s*(if|for|while|foreach|switch|class|function|public|private|protected|abstract|final|interface|trait|namespace|use|require|include)\b/', $line) &&
        !preg_match('/^\s*$/', $line) &&
        !preg_match('/^\s*\/\//', $line) &&
        !preg_match('/^\s*\*/', $line) &&
        !preg_match('/^\s*\/\*/', $line) &&
        !preg_match('/^\s*\*\//', $line)) {
        rbf_log_error("Line $line_num: Possible missing semicolon: " . trim($line), 'SYNTAX_WARNING');
    }
}

rbf_log_error("Brace balance: $brace_count", 'BRACE_CHECK');
rbf_log_error("Parenthesis balance: $parenthesis_count", 'PARENTHESIS_CHECK');
rbf_log_error("Bracket balance: $bracket_count", 'BRACKET_CHECK');

if ($brace_count !== 0) {
    rbf_log_error("WARNING: Unbalanced braces detected!", 'SYNTAX_ERROR');
}

if ($parenthesis_count !== 0) {
    rbf_log_error("WARNING: Unbalanced parentheses detected!", 'SYNTAX_ERROR');
}

if ($bracket_count !== 0) {
    rbf_log_error("WARNING: Unbalanced brackets detected!", 'SYNTAX_ERROR');
}

rbf_log_error("=== DEBUG SESSION COMPLETE ===", 'INFO');
?>

=== END DEBUG LOG ===
